{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc && concurrently -k -n tsc,api \"tsc -w --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "concurrently": "^10.0.0",
    "typescript": "^7.0.0"
  }
}
