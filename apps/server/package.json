{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "yarn build && concurrently -k -n tsc,api \"tsc -w --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "yarn build && node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "db:up": "docker compose -f ../../docker-compose.yml up -d --wait db",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.0.0",
    "concurrently": "^10.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^7.0.0"
  }
}
