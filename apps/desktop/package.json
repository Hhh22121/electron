{
  "name": "desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "yarn build:main && concurrently -k -n tsc,electron \"tsc -w --preserveWatchOutput\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:server": "yarn build:main && concurrently -k -n tsc,server \"tsc -w --preserveWatchOutput\" \"node --watch dist/server/standalone.js\"",
    "build:main": "tsc",
    "build": "tsc && node scripts/copy-web.mjs",
    "start": "electron .",
    "server": "node dist/server/standalone.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/server/**/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "concurrently": "^10.0.0",
    "cross-env": "^10.0.0",
    "electron": "^44.0.0",
    "typescript": "^7.0.0",
    "wait-on": "^9.0.0"
  }
}
